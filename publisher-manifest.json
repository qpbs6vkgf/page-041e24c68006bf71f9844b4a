          "version": 3,
          "body": "<style>\n:root{--deep:#0c2036;--deep-2:#112c48;--deep-3:#17395c;--amber:#e7a23b;--amber-soft:#f5c97e;--paper:#f3f1ec;--ink:#12202e;--muted:#5d6b79;--line:rgba(12,32,54,.14);--line-soft:rgba(243,241,236,.2)}\n*{box-sizing:border-box}\nhtml{-webkit-text-size-adjust:100%}\nbody{margin:0;font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",\"Noto Sans CJK SC\",system-ui,sans-serif;background:var(--paper);color:var(--ink);line-height:1.75;font-size:16px}\na{color:inherit}\nh1,h2,h3{line-height:1.28;margin:0;font-weight:700;letter-spacing:-.01em}\np{margin:0}\n.wrap{max-width:1120px;margin:0 auto;padding:0 22px}\n.wrap-narrow{max-width:820px;margin:0 auto;padding:0 22px}\n\n/* 顶部面包屑 + 目录 */\n.topbar{background:var(--deep);color:var(--paper);border-bottom:1px solid var(--line-soft)}\n.breadcrumb{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:.8rem;letter-spacing:.04em;padding:14px 0 0;color:rgba(243,241,236,.62)}\n.breadcrumb span.sep{color:rgba(243,241,236,.34)}\n.breadcrumb b{color:var(--amber-soft);font-weight:600}\n.toc{display:flex;flex-wrap:wrap;gap:6px 20px;padding:12px 0 16px;font-size:.83rem}\n.toc a{text-decoration:none;color:rgba(243,241,236,.8);border-bottom:1px solid transparent;padding-bottom:2px}\n.toc a:hover,.toc a:focus{border-bottom-color:var(--amber);color:#fff}\n.toc .num{color:var(--amber);font-weight:700;margin-right:5px;font-variant-numeric:tabular-nums}\n\n/* 首屏：杂志式多栏网格 + 引言 */\n.hero{background:var(--deep);color:var(--paper);padding:0 0 66px;position:relative;overflow:hidden}\n.hero-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:0 54px;align-items:start}\n.hero-main{padding-top:8px}\n.kicker{display:inline-block;font-size:.74rem;letter-spacing:.22em;text-transform:uppercase;color:var(--amber);border:1px solid rgba(231,162,59,.5);padding:5px 11px;border-radius:2px;margin-bottom:22px}\n.hero h1{font-size:clamp(2.4rem,5.6vw,4.1rem);line-height:1.06;letter-spacing:-.03em;margin-bottom:20px}\n.hero h1 .thin{display:block;font-weight:400;font-size:.44em;letter-spacing:.01em;color:rgba(243,241,236,.68);margin-top:14px;line-height:1.5}\n.hero-lede{font-size:1.02rem;color:rgba(243,241,236,.78);max-width:34em;padding-top:22px;border-top:1px solid var(--line-soft)}\n.hero-quote{margin-top:34px;padding-left:18px;border-left:3px solid var(--amber);font-size:1.12rem;color:#fff;max-width:30em}\n.hero-quote cite{display:block;margin-top:10px;font-style:normal;font-size:.82rem;color:rgba(243,241,236,.55);letter-spacing:.06em}\n.hero-side{display:grid;gap:1px;background:var(--line-soft);border-top:1px solid var(--line-soft);margin-top:8px}\n.side-block{background:var(--deep);padding:20px 0 20px 22px;border-left:1px solid var(--line-soft)}\n.side-block .label{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--amber);margin-bottom:7px}\n.side-block .value{font-size:1.34rem;font-weight:700;color:#fff;line-height:1.35}\n.side-block .note{font-size:.84rem;color:rgba(243,241,236,.6);margin-top:5px}\n.hero-foot{margin-top:44px;display:flex;flex-wrap:wrap;gap:14px 26px;font-size:.83rem;color:rgba(243,241,236,.6)}\n.hero-foot a{color:var(--amber-soft);text-decoration:none;border-bottom:1px solid rgba(231,162,59,.45)}\n.hero-foot a:hover{border-bottom-color:var(--amber-soft)}\n\n/* 通用区块 */\nsection{padding:66px 0}\n.sec-head{display:grid;grid-template-columns:auto 1fr;gap:20px;align-items:baseline;margin-bottom:38px}\n.sec-no{font-size:2.6rem;font-weight:800;color:rgba(12,32,54,.14);font-variant-numeric:tabular-nums;line-height:1}\n.sec-head h2{font-size:clamp(1.5rem,2.8vw,2.05rem);color:var(--deep)}\n.sec-head .sub{margin-top:8px;font-size:.92rem;color:var(--muted);max-width:44em}\n.alt{background:#fff}\n\n/* 使用说明 */\n.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}\n.step{background:#fff;padding:26px 22px 30px;position:relative}\n.step .n{font-size:2.9rem;font-weight:800;color:var(--amber);line-height:1;font-variant-numeric:tabular-nums;opacity:.85;display:block;margin-bottom:14px}\n.step h3{font-size:1.02rem;color:var(--deep);margin-bottom:9px}\n.step p{font-size:.9rem;color:var(--muted)}\n.step .try{display:inline-block;margin-top:16px;font-size:.8rem;color:var(--deep);text-decoration:none;border-bottom:1px dashed rgba(12,32,54,.4)}\n.step .try:hover{border-bottom-color:var(--deep)}\n\n/* 套餐：阶梯式递进 + 编号大字压底 */\n.plans{display:grid;gap:18px}\n.plan{position:relative;overflow:hidden;background:#fff;border:1px solid var(--line);padding:30px 26px 34px;display:grid;grid-template-columns:1.05fr 1.5fr;gap:12px 40px}\n.plan::after{content:attr(data-index);position:absolute;right:-4px;bottom:-38px;font-size:8.4rem;font-weight:800;line-height:1;color:rgba(12,32,54,.055);letter-spacing:-.05em;pointer-events:none}\n.plan:nth-child(1){margin-right:14%}\n.plan:nth-child(2){margin-right:7%}\n.plan:nth-child(3){margin-right:0}\n.plan.featured{background:var(--deep);color:var(--paper);border-color:var(--deep)}\n.plan.featured::after{color:rgba(243,241,236,.075)}\n.plan-title{display:flex;align-items:center;gap:10px;flex-wrap:wrap}\n.plan-title h3{font-size:1.24rem;color:var(--deep)}\n.plan.featured .plan-title h3{color:#fff}\n.tag{font-size:.68rem;letter-spacing:.12em;padding:3px 8px;border:1px solid var(--amber);color:#a06d16;border-radius:2px;text-transform:uppercase}\n.plan.featured .tag{border-color:var(--amber);color:var(--amber-soft)}\n.plan-price{margin-top:16px;font-size:1.72rem;font-weight:800;color:var(--deep);font-variant-numeric:tabular-nums;line-height:1.2}\n.plan.featured .plan-price{color:#fff}\n.plan-price small{font-size:.78rem;font-weight:500;color:var(--muted);margin-left:4px}\n.plan.featured .plan-price small{color:rgba(243,241,236,.62)}\n.plan-annual{font-size:.84rem;color:var(--muted);margin-top:4px}\n.plan.featured .plan-annual{color:rgba(243,241,236,.68)}\n.plan-note{margin-top:14px;font-size:.83rem;color:var(--muted);border-top:1px solid var(--line);padding-top:12px}\n.plan.featured .plan-note{color:rgba(243,241,236,.66);border-top-color:var(--line-soft)}\n.plan ul{margin:0;padding:0;list-style:none;display:grid;gap:9px;align-content:start}\n.plan li{font-size:.93rem;color:#26374a;padding-left:18px;position:relative}\n.plan li::before{content:\"\";position:absolute;left:0;top:.62em;width:7px;height:7px;border:1.5px solid var(--amber);transform:rotate(45deg)}\n.plan.featured li{color:rgba(243,241,236,.9)}\n.plans-foot{margin-top:26px;font-size:.88rem;color:var(--muted);padding:16px 20px;background:rgba(231,162,59,.1);border-left:3px solid var(--amber)}\n\n/* 配对建议 */\n.pairs{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}\n.pair{background:#fff;border:1px solid var(--line);padding:26px 24px;position:relative;overflow:hidden}\n.pair::after{content:attr(data-index);position:absolute;right:-2px;bottom:-30px;font-size:6rem;font-weight:800;color:rgba(12,32,54,.05);line-height:1}\n.pair h3{font-size:1.04rem;color:var(--deep);margin-bottom:10px}\n.pair p{font-size:.92rem;color:var(--muted)}\n\n/* 客户端说明 */\n.clients{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;background:var(--line);border:1px solid var(--line)}\n.client{background:#fff;padding:24px 22px}\n.client h3{font-size:1rem;color:var(--deep);margin-bottom:8px}\n.client p{font-size:.9rem;color:var(--muted)}\n.client .status{display:inline-block;margin-top:12px;font-size:.76rem;letter-spacing:.08em;color:var(--muted);border:1px dashed var(--line);padding:3px 9px}\n\n/* FAQ：按主题分组 */\n.faq-group{margin-bottom:32px}\n.faq-group:last-child{margin-bottom:0}\n.faq-group h3{font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;color:#8a6a26;padding-bottom:10px;border-bottom:2px solid var(--amber);margin-bottom:4px}\n.qa{padding:20px 0;border-bottom:1px solid var(--line);display:grid;grid-template-columns:minmax(0,0.95fr) minmax(0,1.35fr);gap:6px 28px}\n.qa:last-child{border-bottom:0}\n.qa dt{font-weight:700;color:var(--deep);font-size:.98rem}\n.qa dd{margin:0;font-size:.92rem;color:var(--muted)}\n.qa dt::before{content:\"问\";display:inline-block;font-size:.68rem;color:#fff;background:var(--deep);padding:1px 5px;margin-right:9px;vertical-align:2px;border-radius:2px;letter-spacing:.06em}\n\n/* 结尾信息带 */\n.closing{background:var(--deep-2);color:var(--paper);padding:54px 0}\n.closing-grid{display:grid;grid-template-columns:1.5fr 1fr;gap:32px 48px;align-items:end}\n.closing h2{font-size:clamp(1.4rem,2.6vw,1.9rem);color:#fff;margin-bottom:14px}\n.closing p{font-size:.94rem;color:rgba(243,241,236,.72)}\n.closing .links{display:grid;gap:10px;font-size:.88rem}\n.closing .links a{color:var(--amber-soft);text-decoration:none;border-bottom:1px solid rgba(231,162,59,.4);justify-self:start;padding-bottom:1px}\n.closing .links span{color:rgba(243,241,236,.55);font-size:.82rem}\n\nfooter{background:var(--deep);color:rgba(243,241,236,.5);font-size:.8rem;padding:22px 0;border-top:1px solid var(--line-soft)}\nfooter .wrap{display:flex;flex-wrap:wrap;gap:8px 20px;justify-content:space-between}\n\n@media (max-width:860px){\n  .hero-grid{grid-template-columns:1fr;gap:32px}\n  .hero-side{border-top:1px solid var(--line-soft)}\n  .side-block{border-left:0;border-top:1px solid var(--line-soft);padding-left:0;padding-top:16px}\n  .side-block:first-child{border-top:0;padding-top:0}\n  .steps{grid-template-columns:1fr}\n  .plan{grid-template-columns:1fr;margin-right:0!important}\n  .plan::after{font-size:6rem;bottom:-22px}\n  .pairs{grid-template-columns:1fr}\n  .clients{grid-template-columns:1fr}\n  .qa{grid-template-columns:1fr;gap:8px}\n  .closing-grid{grid-template-columns:1fr;align-items:start}\n  section{padding:52px 0}\n  .sec-no{font-size:2rem}\n}\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <div class=\"breadcrumb\">\n      <a href=\"#\">首页</a>\n      <span class=\"sep\">/</span>\n      <span>产品说明</span>\n      <span class=\"sep\">/</span>\n      <b>牧牛云</b>\n    </div>\n    <nav class=\"toc\" aria-label=\"页面目录\">\n      <a href=\"#guide\"><span class=\"num\">01</span>怎么用</a>\n      <a href=\"#plans\"><span class=\"num\">02</span>套餐与用量</a>\n      <a href=\"#choose\"><span class=\"num\">03</span>怎么挑</a>\n      <a href=\"#clients\"><span class=\"num\">04</span>客户端</a>\n      <a href=\"#faq\"><span class=\"num\">05</span>常见问题</a>\n    </nav>\n  </div>\n</div>\n\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <div class=\"hero-grid\">\n      <div class=\"hero-main\">\n        <span class=\"kicker\">套餐说明 · 使用指引</span>\n        <h1>牧牛云\n          <span class=\"thin\">把三档套餐的差别讲清楚，比把价格讲漂亮更重要。</span>\n        </h1>\n        <p class=\"hero-lede\">\n          你大概已经见过太多“无限流量”“极速节点”的说法。这一页不做那种承诺。\n          我们只做一件事：把牧牛云每一档套餐装了什么、适合谁、什么时候该停一停，\n          按你实际会问的顺序摆出来。看完再决定，不着急。\n        </p>\n        <blockquote class=\"hero-quote\">\n          先问自己每个月大概用多少，再问套餐能给你多少。顺序反了，钱就花得不踏实。\n          —— 本页的编辑原则\n        </blockquote>\n        <div class=\"hero-foot\">\n          <span>三档套餐 · 五组问答</span>\n          <a href=\"#plans\">直接看套餐对照</a>\n          <a href=\"#faq\">先读常见问题</a>\n        </div>\n      </div>\n\n      <aside class=\"hero-side\" aria-label=\"速览信息\">\n        <div class=\"side-block\">\n          <div class=\"label\">套餐档位</div>\n          <div class=\"value\">基础 / 旗舰 / 团队</div>\n          <div class=\"note\">月付与年付两种结算方式并存。</div>\n        </div>\n        <div class=\"side-block\">\n          <div class=\"label\">流量跨度</div>\n          <div class=\"value\">100GB — 1000GB</div>\n          <div class=\"note\">按月计，档位之间差距十倍。</div>\n        </div>\n        <div class=\"side-block\">\n          <div class=\"label\">设备额度</div>\n          <div class=\"value\">3 / 5 / 20 台</div>\n          <div class=\"note\">同时在线计入额度，切换设备不等于增加额度。</div>\n        </div>\n        <div class=\"side-block\">\n          <div class=\"label\">年付折算</div>\n          <div class=\"value\">约等于十个月</div>\n          <div class=\"note\">年付按十个月计收，省下的两个月是纸面上的数字。</div>\n        </div>\n      </aside>\n    </div>\n  </div>\n</header>\n\n<main>\n\n  <section id=\"guide\" class=\"alt\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-no\">01</div>\n        <div>\n          <h2>先回答一个问题：你打算怎么用它？</h2>\n          <p class=\"sub\">如果这句话你答不上来，先别买。下面三步是把这个问题拆开的方式，按顺序做完，套餐自然就落到某一档上。</p>\n        </div>\n      </div>\n\n      <div class=\"steps\">\n        <article class=\"step\">\n          <span class=\"n\">1</span>\n          <h3>估一下你每月真正会走多少流量</h3>\n          <p>看视频、开网页、传文件，三种用法走的量差得很远。别估峰值，估平时的平均数，然后往上留三成余量。基础版每月 100GB 对轻度使用够，但把高清视频当日常的人很快就会顶到天花板。</p>\n          <a class=\"try\" href=\"#plans\">去看流量档位</a>\n        </article>\n        <article class=\"step\">\n          <span class=\"n\">2</span>\n          <h3>数一下要同时在线的设备</h3>\n          <p>手机、笔电、平板、家里那台盒子，一台一台数。注意是“同时在线”而不是“注册过”。三台设备的人买旗舰版是浪费，五台以上的人买基础版会天天抢额度。</p>\n          <a class=\"try\" href=\"#choose\">看看怎么配</a>\n        </article>\n        <article class=\"step\">\n          <span class=\"n\">3</span>\n          <h3>决定是月付还是年付</h3>\n          <p>年付按十个月计费，便宜是便宜，但你得先确认自己会用满一年。第一档的使用习惯往往在前两个月才稳定下来，所以第一次订购按月付更稳，稳定了再谈年付。</p>\n          <a class=\"try\" href=\"#faq\">年付疑问先看这里</a>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-no\">02</div>\n        <div>\n          <h2>三档套餐，一档比一档宽</h2>\n          <p class=\"sub\">价格与权益照实列出，不做“原价划掉”的戏。旗舰版被标注为推荐，但这只是我们基于多数人的用量给出的默认值，不是结论。</p>\n        </div>\n      </div>\n\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-title\">\n              <h3>基础版</h3>\n            </div>\n            <div class=\"plan-price\">¥15<small>/月</small></div>\n            <div class=\"plan-annual\">按年付 ¥150/年</div>\n            <p class=\"plan-note\">适合用量不大、设备不多、主要拿来看网页和偶尔视频的人。</p>\n          </div>\n          <ul>\n            <li>每月 100GB 流量</li>\n            <li>可同时 3 台设备在线</li>\n            <li>含基础流媒体解锁</li>\n            <li>使用普通线路节点池</li>\n          </ul>\n        </article>\n\n        <article class=\"plan featured\">\n          <div>\n            <div class=\"plan-title\">\n              <h3>旗舰版</h3>\n              <span class=\"tag\">默认推荐</span>\n            </div>\n            <div class=\"plan-price\">¥35<small>/月</small></div>\n            <div class=\"plan-annual\">按年付 ¥350/年</div>\n            <p class=\"plan-note\">多数人的用量会落在这里：设备四五台，日常看片，偶尔在意延迟。</p>\n          </div>\n          <ul>\n            <li>每月 300GB 流量</li>\n            <li>可同时 5 台设备在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n        </article>\n\n        <article class=\"plan\">\n          <div>\n            <div class=\"plan-title\">\n              <h3>团队版</h3>\n            </div>\n            <div class=\"plan-price\">¥85<small>/月</small></div>\n            <div class=\"plan-annual\">按年付 ¥850/年</div>\n            <p class=\"plan-note\">多人共用一个额度时才有意义。一个人买团队版，大概率是买多了。</p>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量</li>\n            <li>可同时 20 台设备在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n        </article>\n      </div>\n\n      <div class=\"plans-foot\">\n        三档套餐按同一套规则计算流量与设备额度，差别只在额度大小与线路层级。年付价格均按十个月计收，折合下来每档都省两个月；是否值得，取决于你会不会用满十二个月。\n      </div>\n    </div>\n  </section>\n\n  <section id=\"choose\" class=\"alt\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-no\">03</div>\n        <div>\n          <h2>两种常见情形，两种不同的答案</h2>\n          <p class=\"sub\">套餐不是越多越好，是刚好够用最好。下面两组对照，覆盖了大多数人做决定时卡住的地方。</p>\n        </div>\n      </div>\n\n      <div class=\"pairs\">\n        <article class=\"pair\">\n          <h3>一个人用，四五台设备，每晚看一集剧</h3>\n          <p>这是旗舰版的典型场景：300GB 对每晚一集高清来说有富余，5 台设备额度也刚好覆盖手机、笔电、平板和电视盒。基础版的 3 台额度在这里会显得局促，不是流量不够，是设备数不够。</p>\n        </article>\n        <article class=\"pair\">\n          <h3>三四个同事共用，一起跑同样的任务</h3>\n          <p>这种情况下流量消耗是叠加的，1000GB 与 20 台额度才撑得住，团队版的定制路由也有了用处。如果只是两个人偶尔用，团队版就是浪费，中间那档更合适。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <div class=\"sec-no\">04</div>\n        <div>\n          <h2>客户端：用什么连，得看你手上是什么</h2>\n          <p class=\"sub\">这里不列具体下载地址，因为没有可靠来源之前，写上去的链接就是错的。下表说明各类系统上的选择方向，具体安装方式请以你订购后获得的说明为准。</p>\n        </div>\n      </div>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <h3>桌面端 · Windows / macOS</h3>\n          <p>桌面系统上通常选择支持订阅配置导入的客户端。安装后把订阅链接粘贴进去，客户端会自行拉取线路列表，之后改套餐或换线路只需更新订阅即可，不必重新配置。</p>\n          <span class=\"status\">配置方式：订阅导入</span>\n        </article>\n        <article class=\"client\">\n          <h3>移动端 · iOS / Android</h3>\n          <p>移动端的选择更多受地区与商店上架情况影响，同一个客户端在不同地区的可用性可能不同。建议先确认自己账号所在的商店能否找到可用工具，再决定是否适合用手机连。</p>\n          <span class=\"status\">可用性因地区而异</span>\n        </article>\n        <article class=\"client\">\n          <h3>路由器 · 全屋共用</h3>\n          <p>把连接放在路由器上，全屋设备都走同一条线路，好处是一次配置长期省心；代价是设备额度会按实际在网的设备算，团队版的 20 台额度在这种用法下更实际。</p>\n          <span class=\"status\">注意设备额度计算</span>\n        </article>\n        <article class=\"client\">\n          <h3>订阅更新与线路切换</h3>\n          <p>线路列表会随节点池调整而变化，客户端定期更新订阅即可拿到最新列表。如果发现某条线路不可用，先在客户端里手动切换，而不是立刻怀疑套餐本身出了问题。</p>\n          <span class=\"status\">先切线路，再排查</span>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"alt\">\n    <div class=\"wrap-narrow\">\n      <div class=\"sec-head\">\n        <div class=\"sec-no\">05</div>\n        <div>\n          <h2>常见问题，按你能问到的顺序排</h2>\n          <p class=\"sub\">分成三组：钱怎么花、用量怎么算、出了问题怎么办。每一问下面都给了直接的回答，不绕。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于价格与结算</h3>\n        <dl>\n          <div class=\"qa\">\n            <dt>年付真的等于十个月的钱吗？</dt>\n            <dd>是的。三档套餐的年付价格都是把月付单价乘以十，基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。省下的两个月是明面上的算法，不是限时活动，也不会因为活动结束而变回去。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>我应该第一次就买年付吗？</dt>\n            <dd>不建议。你的实际用量通常要一到两个月才能看清楚，尤其是视频和备份类用法。先按月付用一段时间，确认额度有余、设备也够，再考虑换年付，这个顺序不会让你多花钱。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>中途升级档位，差价怎么算？</dt>\n            <dd>这类结算方式属于订购时的具体规则，本页不代作说明。请在订购环节确认当期政策，避免按猜测操作。我们宁可你先问清楚，也不希望你事后才发现算错。</dd>\n          </div>\n        </dl>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于流量与设备</h3>\n        <dl>\n          <div class=\"qa\">\n            <dt>100GB 到底能撑多久？</dt>\n            <dd>取决于你看什么。文字网页与普通浏览消耗很少，长时间的高清视频才是主要开销。如果你每天固定看剧，基础版的 100GB 大概率撑不满一个月；如果只是查资料、偶尔看片，它就够用。按自己的习惯估，别按别人的。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>设备额度是按注册算还是按在线算？</dt>\n            <dd>按同时在线计算。换一台设备连上去，旧的那台如果还连着，额度不会因此释放。所以三台额度并不等于“只能装在三台机器上”，而是同一时刻最多三台在连。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>流量用超了会怎样？</dt>\n            <dd>本页不描述超额后的具体处理细节，因为这类规则需要以订购时展示的条款为准。可行且稳妥的做法是：把用量留在额度的八成以内，需要更多时提前升档，而不是等到超了再处理。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>普通线路和 VIP 高带宽节点差在哪？</dt>\n            <dd>差别在线路层级，而不是“能用 / 不能用”。基础版使用普通线路节点池，旗舰版与团队版分别对应更高层级的线路资源，团队版另有 VIP 专属高带宽节点。具体线路质量会随网络环境变化，不做速度承诺。</dd>\n          </div>\n        </dl>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3>关于使用与排障</h3>\n        <dl>\n          <div class=\"qa\">\n            <dt>连不上时，第一步该做什么？</dt>\n            <dd>先在客户端里换一条线路，再更新一次订阅。多数连接问题出在线路或订阅过期，而不是套餐本身。两步都做完仍然不行，再带着客户端名称、系统版本和具体现象去提工单，效率会高很多。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>流媒体解锁是承诺还是能力范围？</dt>\n            <dd>是能力范围。基础版含基础流媒体解锁，旗舰版与团队版提供全节点原生流媒体解锁。但平台方的检测策略会变，能不能解锁不由单方决定，所以本页不把它写成必然结果。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>团队版一定能定制定路由吗？</dt>\n            <dd>套餐权益里写的是“支持企业定制路由”，指的是具备这项能力，具体怎么配需要在下单时与对接人确认，不是自动生效。专属客户经理服务同理，属于订购后安排的服务项。</dd>\n          </div>\n          <div class=\"qa\">\n            <dt>用路由器连，算几台设备？</dt>\n            <dd>按实际在网的设备算。路由器本身只是承载，连在后面的每台终端都会占用额度。这也是为什么家庭或小团队场景更适合直接看团队版的 20 台额度，而不是勉强用基础版。</dd>\n          </div>\n        </dl>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<section class=\"closing\">\n  <div class=\"wrap closing-grid\">\n    <div>\n      <h2>看到这里，你大概已经知道自己属于哪一档了</h2>\n      <p>如果不确定，就选中间那档，按月付，用满一个月再判断。牧牛云的三档套餐之间没有隐藏的门槛，差别都在明面上：流量、设备数、线路层级、支持优先级。剩下的，交给你的实际用量来回答。</p>\n    </div>\n    <div class=\"links\">\n      <a href=\"#plans\">重看三档套餐对照</a>\n      <a href=\"#guide\">回到怎么用的三步</a>\n      <span>订购与结算以实际下单页面展示的条款为准。</span>\n    </div>\n  </div>\n</section>\n\n<footer>\n  <div class=\"wrap\">\n    <span>牧牛云 · 套餐与使用说明</span>\n    <span>本页所列价格与权益以页面展示为准，不含未在此说明的额外承诺。</span>\n  </div>\n</footer>",
